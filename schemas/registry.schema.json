{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NemophilistJohn/BOBOCloud-Marketplace-Registry/schemas/registry.schema.json",
  "title": "BOBOCloud Marketplace Root Registry",
  "type": "object",
  "required": ["schemaVersion", "registryId", "updatedAt", "format", "policy", "shards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryId": { "const": "bobocloud.marketplace" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "format": { "type": "object" },
    "policy": {
      "type": "object",
      "required": ["packageIdPattern", "artifactProtocol", "artifactHosts", "artifactDigest", "immutableVersionDocuments"],
      "properties": {
        "packageIdPattern": { "type": "string" },
        "artifactProtocol": { "const": "https" },
        "artifactHosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "raw.githubusercontent.com" }
        },
        "artifactDigest": { "const": "sha256" },
        "immutableVersionDocuments": { "const": true }
      },
      "additionalProperties": false
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "count"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^indexes/[a-z0-9-]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
