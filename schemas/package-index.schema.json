{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NemophilistJohn/BOBOCloud-Marketplace-Registry/schemas/package-index.schema.json",
  "title": "BOBOCloud Marketplace Package Index",
  "type": "object",
  "required": ["schemaVersion", "id", "publisher", "name", "summary", "latest", "versions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "publisher": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "summary": { "type": "object" },
    "latest": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$" },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^packages/[a-z0-9-]+/[a-z0-9-]+/versions/.+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
